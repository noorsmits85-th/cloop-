generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  password        String
  role            UserRole           @default(USER)
  name            String?
  avatar          String?
  rating          Float              @default(5.0)
  isVerified      Boolean            @default(false)
  totalListings   Int                @default(0)
  completedOrders Int                @default(0)
  createdAt       DateTime           @default(now())
  cloopCoins      Int                @default(1500)
  interactions    BlogInteraction[]
  blogs           BlogPost[]
  lifecycles      ProductLifecycle[]
  reviewsReceived Review[]           @relation("Reviewee")
  reviewsGiven    Review[]           @relation("Reviewer")
  products        Product[]
  rentalHistory   RentalHistory[]
}

model Product {
  id              String             @id @default(uuid())
  title           String
  description     String?
  size            String
  bust            Int?
  waist           Int?
  hips            Int?
  gender          GenderCategory     @default(UNISEX)
  condition       ItemCondition
  category        String
  brand           String?
  color           String?
  material        String?
  style           String?
  occasion        String?
  season          String?
  province        String
  districtId      Int?
  wardCode        String?
  specificAddress String
  latitude        Float?
  longitude       Float?
  userId          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  boostExpiresAt  DateTime?
  isHighlighted   Boolean            @default(false)
  blogs           BlogPost[]
  listings        Listing[]
  images          ProductImage[]
  lifecycles      ProductLifecycle[]
  reviews         Review[]
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentalHistory   RentalHistory[]

  @@index([userId])
  @@index([category])
  @@index([gender])
  @@index([province])
  @@index([condition])
  @@index([createdAt(sort: Desc)])
  @@index([material])
  @@index([occasion])
  @@index([size])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model ProductImage {
  id              String   @id @default(uuid())
  productId       String
  url             String
  storageProvider String   @default("cloudinary")
  publicId        String?
  width           Int?
  height          Int?
  bytes           Int?
  format          String?
  isPrimary       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model Listing {
  id              String        @id @default(uuid())
  productId       String
  listingType     ListingType
  status          ListingStatus @default(AVAILABLE)
  basePrice       Int?
  pricing_tiers   Json?
  turnaround_days Int           @default(2)
  salePrice       Int?
  deposit         Int?
  minDays         Int?
  greenPoints     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@index([listingType])
  @@index([basePrice])
  @@index([salePrice])
  @@index([createdAt(sort: Desc)])
}

model RentalHistory {
  id                 String    @id @default(uuid())
  product_id         String
  renterId           String
  renter_name        String?
  renter_phone       String?
  owner_name         String?
  owner_phone        String?
  start_date         DateTime
  end_date           DateTime
  actual_return_date DateTime?
  status             String    @default("pending_payment")
  shippingCode       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  disputes           Dispute[]
  invoice            Invoice?
  product            Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  renter             User      @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@index([renterId])
  @@index([product_id])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("rental_history")
}

model Invoice {
  id            String              @id @default(uuid())
  rentalId      String              @unique
  amount        Int
  status        PaymentStatus       @default(PENDING)
  orderCode     BigInt?             @unique
  paymentLinkId String?             @unique
  payosStatus   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  disputes      Dispute[]
  rental        RentalHistory       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerTransaction[]

  @@index([rentalId])
  @@index([status])
}

model LedgerTransaction {
  id          String     @id @default(uuid())
  invoiceId   String?
  type        LedgerType
  amount      Int
  description String?
  adminId     String?
  status      String     @default("COMPLETED")
  createdAt   DateTime   @default(now())
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([adminId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model Dispute {
  id                 String         @id @default(uuid())
  rentalId           String
  invoiceId          String?
  description        String
  images             String[]
  severity           DamageSeverity
  suggestedDeduction Int
  finalDeduction     Int?
  status             DisputeStatus  @default(PENDING_REVIEW)
  adminNotes         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoice            Invoice?       @relation(fields: [invoiceId], references: [id])
  rental             RentalHistory  @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([invoiceId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetType   String
  targetId     String
  beforeStatus String?
  afterStatus  String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model AccountingPeriod {
  id              String                 @id @default(uuid())
  month           Int
  year            Int
  periodStart     DateTime
  nextPeriodStart DateTime
  status          AccountingPeriodStatus @default(CLOSED)
  revenueTotal    Int
  expenseTotal    Int                    @default(0)
  netProfit       Int
  closedAt        DateTime               @default(now())
  closedByAdminId String
  metadata        String?

  @@unique([month, year])
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String
  revieweeId String
  productId  String?
  rating     Float
  comment    String?
  type       String
  createdAt  DateTime @default(now())
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([revieweeId])
  @@index([productId])
}

model BlogPost {
  id           String            @id @default(uuid())
  title        String
  content      String
  cover_image  String?
  productId    String?
  userId       String
  status       String            @default("PUBLIC")
  isPinned     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  interactions BlogInteraction[]
  product      Product?          @relation(fields: [productId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model BlogInteraction {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  type      String
  content   String?
  createdAt DateTime @default(now())
  blog      BlogPost @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([userId])
}

model ProductLifecycle {
  id        String             @id @default(uuid())
  productId String
  eventType LifecycleEventType
  userId    String
  co2Saved  Float              @default(0.0)
  notes     String?
  createdAt DateTime           @default(now())
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([eventType])
}

enum UserRole {
  ADMIN
  USER
}

enum ListingType {
  RENT
  SELL
  RECYCLE
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  RENTED
  SOLD
  RECYCLED
  HIDDEN
}

enum LifecycleEventType {
  CREATED
  RENTED
  RETURNED
  SOLD
  RECYCLED
}

enum GenderCategory {
  MALE
  FEMALE
  UNISEX
}

enum ItemCondition {
  NEW_WITH_TAGS
  EXCELLENT
  GOOD
  FAIR
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum DisputeStatus {
  PENDING_REVIEW
  DISPUTED
  APPROVED_DEDUCTION
  REJECTED
  RESOLVED
}

enum DamageSeverity {
  LOW
  MEDIUM
  HIGH
}

enum LedgerType {
  DEPOSIT_IN
  REFUND_OUT
  PAYOUT_OUT
  FEE_RETAINED
  COMPENSATION_OUT
  PENALTY_FEE_RETAINED
  MONTHLY_CLOSING_REVENUE
  MONTHLY_CLOSING_EXPENSE
  YEARLY_RETAINED_EARNINGS
}

enum AccountingPeriodStatus {
  CLOSED
  REOPENED
}
