generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  password        String
  role            UserRole           @default(USER)
  name            String?
  avatar          String?
  rating          Float              @default(5.0)
  reviewCount     Int                @default(0)
  isVerified      Boolean            @default(false)
  totalListings   Int                @default(0)
  completedOrders Int                @default(0)
  createdAt       DateTime           @default(now())
  cloopCoins      Int                @default(1500)
  interactions    BlogInteraction[]
  blogs           BlogPost[]
  lifecycles      ProductLifecycle[]
  reviewsReceived Review[]           @relation("Reviewee")
  reviewsGiven    Review[]           @relation("Reviewer")
  products        Product[]
  rentalHistory   RentalHistory[]
}

model Product {
  id              String             @id @default(uuid())
  title           String
  description     String?
  size            String
  bust            Int?
  waist           Int?
  hips            Int?
  gender          GenderCategory     @default(UNISEX)
  condition       ItemCondition
  category        String
  brand           String?
  color           String?
  material        String?
  style           String?
  occasion        String?
  season          String?
  province        String
  districtId      Int?
  wardCode        String?
  specificAddress String
  latitude        Float?
  longitude       Float?
  userId          String?
  status          ProductStatus      @default(IN_CLOSET)
  isDeleted       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  boostExpiresAt  DateTime?
  lastBumpedAt    DateTime?
  isHighlighted   Boolean            @default(false)
  blogs           BlogPost[]
  listings        Listing[]
  images          ProductImage[]
  lifecycles      ProductLifecycle[]
  reviews         Review[]
  user            User?              @relation(fields: [userId], references: [id])
  rentalHistory   RentalHistory[]

  @@index([userId])
  @@index([category])
  @@index([gender])
  @@index([province])
  @@index([condition])
  @@index([createdAt(sort: Desc)])
  @@index([material])
  @@index([occasion])
  @@index([size])
  @@map("products")
}

model ProductImage {
  id              String   @id @default(uuid())
  productId       String
  url             String
  storageProvider String   @default("cloudinary")
  publicId        String?
  width           Int?
  height          Int?
  bytes           Int?
  format          String?
  isPrimary       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([productId, isPrimary])
}

model Listing {
  id              String        @id @default(uuid())
  productId       String
  listingType     ListingType
  status          ListingStatus @default(AVAILABLE)
  basePrice       Int?
  snapshot        Json?
  pricing_tiers   Json?
  turnaround_days Int           @default(2)
  salePrice       Int?
  deposit         Int?
  minDays         Int?
  greenPoints     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isDeleted       Boolean       @default(false)
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([updatedAt, id])
  @@index([productId])
  @@index([status])
  @@index([listingType])
  @@index([basePrice])
  @@index([salePrice])
  @@index([createdAt(sort: Desc)])
}

model RentalHistory {
  id                 String       @id @default(uuid())
  product_id         String
  renterId           String
  ownerId            String?
  renter_name        String?
  renter_phone       String?
  owner_name         String?
  owner_phone        String?
  start_date         DateTime
  end_date           DateTime
  actual_return_date DateTime?
  completedAt        DateTime?
  status             RentalStatus @default(PENDING_APPROVAL)
  shippingCode       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  isDeleted          Boolean      @default(false)
  disputes           Dispute[]
  invoice            Invoice?
  reviews            Review[]
  product            Product      @relation(fields: [product_id], references: [id])
  renter             User         @relation(fields: [renterId], references: [id])

  @@index([renterId])
  @@index([ownerId])
  @@index([product_id])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("rental_history")
}

model Invoice {
  id            String              @id @default(uuid())
  rentalId      String              @unique
  amount        Int
  rentalFee     Int                 @default(0)
  depositAmount Int                 @default(0)
  status        PaymentStatus       @default(PENDING)
  orderCode     BigInt?             @unique
  paymentLinkId String?             @unique
  payosStatus   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  isDeleted     Boolean             @default(false)
  disputes      Dispute[]
  rental        RentalHistory       @relation(fields: [rentalId], references: [id])
  ledgerEntries LedgerTransaction[]
  transactions  TransactionHistory[]

  @@index([rentalId])
  @@index([status])
}

model LedgerTransaction {
  id          String     @id @default(uuid())
  invoiceId   String?
  type        LedgerType
  amount      Int
  description String?
  adminId     String?
  status      String     @default("COMPLETED")
  createdAt   DateTime   @default(now())
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([adminId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model Dispute {
  id                 String         @id @default(uuid())
  rentalId           String
  invoiceId          String?
  description        String
  images             String[]
  severity           DamageSeverity
  suggestedDeduction Int
  finalDeduction     Int?
  status             DisputeStatus  @default(PENDING_REVIEW)
  adminNotes         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoice            Invoice?       @relation(fields: [invoiceId], references: [id])
  rental             RentalHistory  @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@index([invoiceId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetType   String
  targetId     String
  beforeStatus String?
  afterStatus  String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model AccountingPeriod {
  id              String                 @id @default(uuid())
  month           Int
  year            Int
  periodStart     DateTime
  nextPeriodStart DateTime
  status          AccountingPeriodStatus @default(CLOSED)
  revenueTotal    Int
  expenseTotal    Int                    @default(0)
  netProfit       Int
  closedAt        DateTime               @default(now())
  closedByAdminId String
  metadata        String?

  @@unique([month, year])
}

enum ReviewType {
  RENTER_TO_OWNER
  OWNER_TO_RENTER
}

model Review {
  id          String     @id @default(uuid())
  rentalId    String
  reviewerId  String
  revieweeId  String
  rating      Float
  comment     String?
  type        ReviewType
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  rental    RentalHistory @relation(fields: [rentalId], references: [id])
  reviewee  User          @relation("Reviewee", fields: [revieweeId], references: [id])
  reviewer  User          @relation("Reviewer", fields: [reviewerId], references: [id])
  product   Product?      @relation(fields: [productId], references: [id])
  productId String?

  @@unique([rentalId, reviewerId, type])
  @@index([rentalId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([isPublished])
}

model BlogPost {
  id           String            @id @default(uuid())
  title        String
  content      String
  cover_image  String?
  productId    String?
  userId       String
  status       String            @default("PUBLIC")
  isPinned     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  isDeleted    Boolean           @default(false)
  interactions BlogInteraction[]
  product      Product?          @relation(fields: [productId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model BlogInteraction {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  type      String
  content   String?
  createdAt DateTime @default(now())
  blog      BlogPost @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([blogId])
  @@index([userId])
}

model ProductLifecycle {
  id        String             @id @default(uuid())
  productId String
  eventType LifecycleEventType
  userId    String
  co2Saved  Float              @default(0.0)
  notes     String?
  createdAt DateTime           @default(now())
  product   Product            @relation(fields: [productId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([eventType])
}

enum UserRole {
  ADMIN
  USER
}

enum ListingType {
  RENT
  SELL
  RECYCLE
}

enum ProductStatus {
  DRAFT
  IN_CLOSET
  ON_MARKET
  IN_TRANSIT
  WITH_RENTER
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  RENTED
  SOLD
  RECYCLED
  HIDDEN
}

enum LifecycleEventType {
  CREATED
  RENTED
  RETURNED
  SOLD
  RECYCLED
}

enum GenderCategory {
  MALE
  FEMALE
  UNISEX
}

enum ItemCondition {
  NEW_WITH_TAGS
  EXCELLENT
  GOOD
  FAIR
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum RentalStatus {
  PENDING_APPROVAL
  LENDER_SHIPPED
  BORROWER_RECEIVED
  BORROWER_RETURNED
  LENDER_COMPLETED
  DISPUTE
  CANCELLED
}

enum DisputeStatus {
  PENDING_REVIEW
  DISPUTED
  APPROVED_DEDUCTION
  REJECTED
  RESOLVED
}

enum DamageSeverity {
  LOW
  MEDIUM
  HIGH
}

enum LedgerType {
  DEPOSIT_IN
  REFUND_OUT
  PAYOUT_OUT
  FEE_RETAINED
  COMPENSATION_OUT
  PENALTY_FEE_RETAINED
  MONTHLY_CLOSING_REVENUE
  MONTHLY_CLOSING_EXPENSE
  YEARLY_RETAINED_EARNINGS
}

enum AccountingPeriodStatus {
  CLOSED
  REOPENED
}

model EcoMetric {
  id          String   @id @default(uuid())
  keyword     String   @unique
  waterFactor Int      @default(2000)
  co2Factor   Float    @default(15.0)
  greenPts    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eco_metrics")
}

enum TransactionStatus {
  VERIFIED
  PROCESSED
  AMOUNT_MISMATCH
  DUPLICATE
  FAILED
}

model TransactionHistory {
  id            String            @id @default(uuid())
  eventId       String?           @unique // Mã Webhook từ PayOS (Chặn dội bom đúp)
  orderCode     BigInt            @unique // Mã đơn hàng map với PayOS
  invoiceId     String?
  amount        Int               // Số tiền thực tế PayOS báo về
  currency      String            @default("VND")
  invoiceAmount Int               // Số tiền cross-check từ bảng Invoice
  status        TransactionStatus
  rawPayload    Json              // Lưu trữ toàn vẹn chứng cứ (Postgres JSONB)
  processedAt   DateTime?         // Timestamp khi thực thi xong Atomic Transaction
  createdAt     DateTime          @default(now())
  
  invoice       Invoice?          @relation(fields: [invoiceId], references: [id])
  
  @@index([orderCode])
  @@index([eventId])
}
